# Add exact official product URL(s) here once known, separated by commas.
TARGET_URLS=

# Monitor new products plus the highest-priority TCG, plush, and figure categories.
DISCOVERY_URLS="https://www.pokemoncenter.com/category/new-releases,https://www.pokemoncenter.com/category/trading-card-game,https://www.pokemoncenter.com/category/plush,https://www.pokemoncenter.com/category/figures-and-pins"
TRACK_ALL_PRODUCTS=true

# Used only when TRACK_ALL_PRODUCTS=false.
MATCH_TERMS="30th celebration"
PRODUCT_TERMS="elite trainer box,booster bundle,3 pack,three pack,sylveon ex,greninja ex,poster collection,binder collection,mew figure collection,mewtwo figure collection,ditto premium collection"

# A five-minute interval plus jitter is responsive without hammering the site.
CHECK_INTERVAL_SECONDS=300
CHECK_JITTER_SECONDS=30
REQUEST_TIMEOUT_SECONDS=20
STATE_FILE=data/state.json
LOG_LEVEL=INFO

# Local Playwright queue detector.
QUEUE_URL=https://www.pokemoncenter.com/
QUEUE_CHECK_INTERVAL_SECONDS=90
QUEUE_CHECK_JITTER_SECONDS=15
QUEUE_STATE_FILE=data/queue-state.json
PLAYWRIGHT_PROFILE_DIR=data/browser-profile
PLAYWRIGHT_HEADLESS=false

# Discord: Server Settings > Integrations > Webhooks > New Webhook.
DISCORD_WEBHOOK_URL=

# Email example for Gmail (use an App Password, not your normal password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# CardLens billing. Use a long random cookie secret in hosted environments.
CARDLENS_COOKIE_SECRET=
CARDLENS_BILLING_DB=data/grading/billing.sqlite
CARDLENS_DEVELOPER_PASSWORD=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_ANNUAL_PRICE_ID=
